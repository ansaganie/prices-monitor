# Local runs only — Bun loads .env automatically. In CI these come from repo secrets
# (GITHUB_TOKEN and GITHUB_REPOSITORY are set automatically by GitHub Actions).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
TELEGRAM_CHAT_ID=987654321

# Needed to read/write run state, stored in a GitHub Release body — see
# docs/adr/0001-release-body-for-state-persistence.md. A classic PAT with the
# "repo" scope (or a fine-grained token with Contents: Read & Write) works.
GITHUB_TOKEN=ghp_exampleTokenWithRepoScope
GITHUB_REPOSITORY=ansaganie/prices-monitor

# Optional: set to 1 to print the alert instead of sending it to Telegram.
# DRY_RUN=1
